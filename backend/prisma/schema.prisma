// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [postgis]
}

// --- Enumerations ---

enum ContractType {
  CDI
  CDD
  ALTERNANCE
  STAGE
  FREELANCE
  AUTRE
}

enum ExperienceLevel {
  DEBUTANT
  INTERMEDIAIRE
  CONFIRME
}

enum ApplicationStatus {
  ENVOYE
  VU
  EN_COURS
  ACCEPTE
  REFUSE
  RETIRE
}

enum SwipeActorType {
  CANDIDATE
  RECRUITER
}

enum SwipeDirection {
  LEFT
  RIGHT
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

// --- CENTRAL IDENTITY MODEL ---
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password           String
  role      UserRole  @default(CANDIDATE) // User role
  hashedRefreshToken String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations (a User can have a candidate profile and/or a recruiter profile)
  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
}

// --- PROFILE MODELS ---

model CandidateProfile {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Profile-specific fields
  firstName            String
  lastName             String
  resumeUrl            String?
  photoUrl             String?
  coverLetterText      String?
  desiredJobTitle      String?
  desiredContractTypes ContractType[] @default([])
  locationWKT          String?
  locationName         String?
  searchRadiusKm       Int?
  isActive             Boolean    @default(true)
  notificationsEnabled Boolean    @default(true)
  pushToken String?  @unique // Le token de notification push Expo

  experienceLevel      ExperienceLevel? // Experience level (optional)
  interestedInCategories JobCategory[] @relation("CandidateInterestedCategories")

  // Relation to User (a candidate profile belongs to a single user)
  user   User @relation(fields: [userId], references: [id])
  userId String  @unique // Unique one-to-one relation

  // Other relations
  applications Application[]
  swipes       Swipe[]
}

model RecruiterProfile {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Profile-specific fields
  firstName         String
  lastName          String
  photoUrl          String?          // Recruiter profile photo
  internalRoleDefault String?
  matchWindowStart  DateTime?
  matchesTodayCount Int       @default(0)
  dailyMatchLimit   Int       @default(100)
  pushToken String?  @unique // Expo push notification token

  // SEARCH CRITERIA FIELDS
  locationWKT          String?          // Zone where the recruiter searches
  locationName         String?
  searchDescription    String?          // Recruiter tagline
  desiredExperienceLevel ExperienceLevel? // Desired experience level
  desiredContractTypes ContractType[]   @default([]) // Desired contract types
  searchedCategories   JobCategory[]    @relation("RecruiterSearchedCategories") // Searched categories
  
  // Relation to User (a recruiter profile belongs to a single user)
  user   User @relation(fields: [userId], references: [id])
  userId String  @unique // Unique one-to-one relation

  // Other relations
  memberships        RecruiterMembership[]
  swipes             Swipe[]
  viewedApplications Application[]       @relation("ViewedByRecruiter")
  createdJobOffers   JobOffer[]          @relation("CreatedByRecruiter")
}

// --- OTHER MODELS ---

model Company {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  name      String
  siret     String    @unique
  logoUrl   String?
  jobOffers JobOffer[]
  members   RecruiterMembership[]
}

model RecruiterMembership {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  internalRole String
  isPrimary    Boolean   @default(false)
  recruiter    RecruiterProfile @relation(fields: [recruiterId], references: [id])
  recruiterId  String
  company      Company   @relation(fields: [companyId], references: [id])
  companyId    String
  @@unique([recruiterId, companyId])
}

model JobCategory {
  id        String     @id @default(uuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  name      String     @unique
  jobOffers JobOffer[]

  interestedCandidates CandidateProfile[] @relation("CandidateInterestedCategories")
  searchingRecruiters  RecruiterProfile[] @relation("RecruiterSearchedCategories")
}

model JobOffer {
  id           String         @id @default(uuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  title        String
  description  String
  locationWKT          String?
  locationName         String?
  salaryMin    Int?
  salaryMax    Int?
  currency     String?
  workHours    String?
  isActive     Boolean        @default(true)
  expiresAt    DateTime?
  company      Company        @relation(fields: [companyId], references: [id])
  companyId    String
  applications Application[]
  category    JobCategory @relation(fields: [categoryId], references: [id])
  categoryId  String

  // Fields inherited from recruiter profile
  contractType    ContractType
  experienceLevel ExperienceLevel?

  // Relation to know who created the offer
  createdBy   RecruiterProfile @relation("CreatedByRecruiter", fields: [createdById], references: [id])
  createdById String
}

model Application {
  id                  String            @id @default(uuid())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  status              ApplicationStatus @default(ENVOYE)
  cvUrl               String?
  coverLetterText     String?
  viewedAt            DateTime?
  candidate           CandidateProfile  @relation(fields: [candidateId], references: [id])
  candidateId         String
  job                 JobOffer          @relation(fields: [jobId], references: [id])
  jobId               String
  viewedByRecruiter   RecruiterProfile?        @relation("ViewedByRecruiter", fields: [viewedByRecruiterId], references: [id])
  viewedByRecruiterId String?
  @@unique([candidateId, jobId])
}

model Swipe {
  id        String         @id @default(uuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // The unique relation between the two profiles
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id])
  candidateId String
  recruiter   RecruiterProfile @relation(fields: [recruiterId], references: [id])
  recruiterId String

  // The state of each person's swipes
  candidateDirection SwipeDirection? // Null until the candidate swipes
  recruiterDirection SwipeDirection? // Null until the recruiter swipes

  isMatch   Boolean  @default(false)
  matchedAt DateTime?

  // Only one swipe record can exist per candidate/recruiter pair
  @@unique([candidateId, recruiterId])
}